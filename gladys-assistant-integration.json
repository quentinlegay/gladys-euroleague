{
  "manifest_version": 1,
  "type": "device",
  "name": "EuroLeague",
  "description": {
    "en": "Follow your EuroLeague and EuroCup basketball teams: live scores, next game, scenes.",
    "fr": "Suivez vos équipes de basket EuroLeague et EuroCup : scores en direct, prochain match, scènes."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/quentinlegay/gladys-euroleague:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/quentinlegay/gladys-euroleague/main/cover.png",
  "categories": ["leisure", "services"],
  "keywords": ["euroleague", "euroligue", "eurocup", "basketball", "basket", "score", "sport"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Scores come from the public Euroleague Basketball API: no account, no key. Write the clubs to follow as their code, separated by commas, e.g. PAN, MAD, ASV. A EuroCup club takes the U: prefix, e.g. U:BES. Not sure of a code? Use the \"Find a team\" button below. Each club becomes a device in the Discover tab.",
        "fr": "Les scores viennent de l'API publique d'Euroleague Basketball : pas de compte, pas de clé. Écrivez les clubs à suivre avec leur code, séparés par des virgules, par ex. PAN, MAD, ASV. Un club d'EuroCup prend le préfixe U:, par ex. U:BES. Pas sûr d'un code ? Utilisez le bouton « Trouver une équipe » plus bas. Chaque club devient un appareil dans l'onglet Découverte."
      },
      "links": [
        {
          "url": "https://github.com/quentinlegay/gladys-euroleague/blob/main/docs/en.md#club-codes",
          "label": {
            "en": "Club codes",
            "fr": "Codes des clubs"
          }
        }
      ]
    },
    {
      "key": "teams",
      "type": "string",
      "label": {
        "en": "Teams",
        "fr": "Équipes"
      },
      "description": {
        "en": "Club codes separated by commas (20 at most). Prefix a EuroCup club with U:.",
        "fr": "Codes des clubs séparés par des virgules (20 au plus). Préfixez un club d'EuroCup par U:."
      },
      "placeholder": {
        "en": "e.g. PAN, MAD, ASV",
        "fr": "ex. ASV, PAR, MCO"
      },
      "required": true
    },
    {
      "key": "competition",
      "type": "select",
      "label": {
        "en": "Default competition",
        "fr": "Compétition par défaut"
      },
      "description": {
        "en": "Competition of the codes written without a prefix.",
        "fr": "Compétition des codes écrits sans préfixe."
      },
      "required": false,
      "default": "E",
      "display": "radio",
      "options": [
        {
          "value": "E",
          "label": {
            "en": "EuroLeague",
            "fr": "EuroLeague"
          }
        },
        {
          "value": "U",
          "label": {
            "en": "EuroCup",
            "fr": "EuroCup"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the game texts",
        "fr": "Langue des textes de match"
      },
      "description": {
        "en": "Language of the texts shown on the devices and sent to the scenes.",
        "fr": "Langue des textes affichés sur les appareils et envoyés aux scènes."
      },
      "required": false,
      "default": "en",
      "display": "radio",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        }
      ]
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire"
      },
      "description": {
        "en": "Tip-off times are written in this time zone (IANA name).",
        "fr": "Les heures de coup d'envoi sont écrites dans ce fuseau (nom IANA)."
      },
      "placeholder": {
        "en": "e.g. Europe/Athens",
        "fr": "ex. Europe/Paris"
      },
      "required": false,
      "default": "Europe/Paris"
    },
    {
      "key": "reminder_minutes",
      "type": "number",
      "label": {
        "en": "Tip-off reminder (min)",
        "fr": "Rappel avant le coup d'envoi (min)"
      },
      "description": {
        "en": "The \"Game starting soon\" trigger fires this many minutes before tip-off. 0 turns it off.",
        "fr": "Le déclencheur « Match bientôt » part ce nombre de minutes avant le coup d'envoi. 0 le désactive."
      },
      "required": false,
      "default": 30,
      "min": 0,
      "max": 1440
    },
    {
      "key": "live_refresh",
      "type": "number",
      "label": {
        "en": "Refresh during a game (s)",
        "fr": "Actualisation pendant un match (s)"
      },
      "description": {
        "en": "How often scores are read while a game is live, in seconds.",
        "fr": "Fréquence de lecture des scores pendant un match, en secondes."
      },
      "required": false,
      "default": 30,
      "min": 15,
      "max": 300
    },
    {
      "key": "idle_refresh",
      "type": "number",
      "label": {
        "en": "Refresh between games (min)",
        "fr": "Actualisation entre les matchs (min)"
      },
      "description": {
        "en": "How often the schedule is checked when nothing is live, in minutes.",
        "fr": "Fréquence de vérification du calendrier quand rien n'est en direct, en minutes."
      },
      "required": false,
      "default": 15,
      "min": 5,
      "max": 120
    }
  ],
  "actions": [
    {
      "key": "test_teams",
      "label": {
        "en": "Test the teams",
        "fr": "Tester les équipes"
      },
      "description": {
        "en": "Read the Euroleague API now and show, club by club, what is followed.",
        "fr": "Lit l'API Euroleague maintenant et montre, club par club, ce qui est suivi."
      },
      "timeout_seconds": 60
    },
    {
      "key": "find_team",
      "label": {
        "en": "Find a team",
        "fr": "Trouver une équipe"
      },
      "description": {
        "en": "List the clubs of a competition with the exact code to paste in the Teams field.",
        "fr": "Liste les clubs d'une compétition avec le code exact à coller dans le champ Équipes."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "competition",
          "type": "select",
          "label": {
            "en": "Competition",
            "fr": "Compétition"
