              "value": "U",
              "label": {
                "en": "EuroCup (U)",
                "fr": "EuroCup (U)"
              }
            }
          ]
        },
        {
          "key": "search",
          "type": "string",
          "label": {
            "en": "Search",
            "fr": "Recherche"
          },
          "placeholder": {
            "en": "e.g. Madrid",
            "fr": "ex. Paris"
          },
          "required": false
        }
      ]
    }
  ],
